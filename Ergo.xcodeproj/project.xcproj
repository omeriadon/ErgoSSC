            "Siri/ErgoSiriEvaluations/README.md",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "ErgoTests",
      "target-membership": [
        "ErgoTests",
      ],
      "membership-exceptions": [
        {
          "target": "ErgoTests",
          "exclusions": [
            "README.md",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        { "path": "<SDK>/System/Library/Frameworks/WidgetKit.framework" },
        { "path": "<SDK>/System/Library/Frameworks/SwiftUI.framework" },

        "up-to-next-major-version": "9.0.9",
      },
    }, {
      "kind": "local",
      "path": "ErgoKit",
    },
  ],
  "files": [
    {
      "kind": "folder",
      "path": "Ergo",
      "target-membership": [
        "Ergo",
      ],
      "membership-exceptions": [
        {
          "target": "Ergo",
          "exclusions": [
            "Siri/ErgoSiriEvaluations/ErgoEvaluation.swift",
